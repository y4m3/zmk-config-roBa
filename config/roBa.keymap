#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    macros {
        release_mods: release_mods {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp LCTRL &kp LALT &kp LGUI &kp RSHFT &kp RCTRL &kp RALT &kp RGUI>;
        };
    };

    behaviors {
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };

        bs_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <11 12>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <18 19>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        unstuck {
            bindings = <&release_mods>;
            key-positions = <34 42>;
            timeout-ms = <50>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        config_layer {
            if-layers = <1 3>;
            then-layer = <6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp Q        &kp W       &kp E      &kp R        &kp T                                          &kp Y      &kp U  &kp I      &kp O    &kp P
&hm LCTRL A  &hm LSHFT S &hm LALT D &hm LCTRL F  &kp G        &kp GRAVE        &kp SEMI        &kp H      &kp J  &kp K      &kp L    &kp ENTER
&hm LSHFT Z  &kp X      &kp C       &kp V        &kp B        &kp MINUS        &kp EQUAL       &kp N      &kp M  &kp COMMA  &kp DOT  &lt 2 FSLH
&hm LC(LSHFT) SQT &kp LGUI &kp LCTRL &lt 1 TAB    &lt 5 SPACE  &lt 2 ESC        &kp RSHFT                &bs_del                    &lt 3 ESC
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        SYM {
            bindings = <
&kp N1    &kp N2    &kp N3    &kp N4    &kp N5                                     &kp N6     &kp N7     &kp N8     &kp N9    &kp N0
&kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &kp TILDE        &kp COLON     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR
&kp BSLH  &kp PIPE  &kp LBKT  &kp RBKT  &kp DQT    &kp UNDER        &kp PLUS      &kp LBRC   &kp RBRC   &trans     &trans    &trans
&trans    &trans    &trans    &trans    &trans     &trans           &kp LCTRL     &trans                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NAV {
            bindings = <
&kp HOME       &kp PG_DN      &kp PG_UP   &kp END  &kp INS                                   &trans    &trans     &kp UP     &trans     &trans
&kp LC(MINUS)  &kp LC(EQUAL)  &kp LC(N0)  &trans   &kp PSCRN  &trans          &trans         &trans    &kp LEFT   &kp RIGHT  &trans     &trans
&trans         &trans         &trans      &trans   &trans     &trans          &trans         &trans    &trans     &kp DOWN   &trans     &trans
&trans         &trans         &trans      &trans   &trans     &trans          &trans         &kp DEL                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PG_DN) LC(PG_UP)>;
        };

        FUN {
            bindings = <
&kp F7  &kp F8  &kp F9  &trans   &trans                                       &trans        &trans        &trans        &trans      &trans
&kp F4  &kp F5  &kp F6  &kp F11  &kp F12  &trans          &trans              &kp RSHFT     &kp RCTRL     &kp RALT      &kp RGUI    &trans
&kp F1  &kp F2  &kp F3  &kp F10  &trans   &trans          &kp PSCRN           &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE    &kp C_EJECT      &trans
&trans  &trans  &trans  &trans   &trans   &trans          &trans              &trans                                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp LA(RIGHT) LA(LEFT)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans        &trans         &trans                          &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &kp LA(LEFT)  &kp LA(RIGHT)  &trans  &trans      &trans      &kp LC(LS(TAB))  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))  &kp LC(TAB)   &trans
&trans  &trans  &trans        &trans         &trans  &trans      &trans      &trans           &trans            &trans             &trans        &trans
&trans  &trans  &trans        &trans         &trans  &trans      &trans      &trans                                                              &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        CONFIG {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans          &trans         &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &bootloader     &trans         &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &trans          &trans         &trans                                                  &trans
            >;
        };
    };
};
